modules = ["nodejs-24", "python-base-3.13", "java-graalvm22.3", "php-8.2"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-location-tests"

[[workflows.workflow]]
name = "mobile-location-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile test:location && pnpm --filter @workspace/mobile check:brand-assets && pnpm --filter @workspace/mobile typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "dbus", "atk", "at-spi2-atk", "cups", "gtk3", "pango", "cairo", "alsa-lib", "libdrm", "libxkbcommon", "mesa", "libgbm"]

[userenv]

[userenv.shared]
FACEBOOK_APP_ID = "2260207684544121"
EXPO_PUBLIC_FACEBOOK_APP_ID = "2260207684544121"
EXPO_PUBLIC_FACEBOOK_REDIRECT_URI = "2260207684544121"
MAIL_FROM_ADDRESS = "support@oglandmark.com"

[userenv.development]
LARAVEL_API_URL = "https://api.oglandmark.com"
MAIL_HOST = "smtp.hostinger.com"
MAIL_MAILER = "smtp"
MAIL_PORT = "465"
MAIL_SCHEME = "smtps"
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
SMTP_SECURE = "true"
MEDIA_STORAGE_DIR = "/home/runner/workspace/artifacts/og-landmark-web/public/images/uploads"
LOCAL_PREVIEW_ADMIN_EMAIL = "admin@gmail.com"
APP_ENV = "local"
