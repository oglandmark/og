{
  "expo": {
    "name": "OG Landmark",
    "slug": "og-landmark-uin4dnqfp8-zl28mrpom",
    "version": "5.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/og-landmark-app-icon.png",
    "scheme": "og-land-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oglandmark.app",
      "buildNumber": "61",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "OG Landmark accesses photos you select to create listings, update your profile, and share project media.",
        "NSCameraUsageDescription": "OG Landmark uses the camera when you choose to take a listing, profile, or project photo."
      }
    },
    "android": {
      "package": "com.oglandmark.app",
      "versionCode": 62,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/og-landmark-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/og-landmark-adaptive-foreground.png",
        "backgroundColor": "#0B1F3A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/images/og-landmark-app-icon.png",
      "output": "static"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/videos/*",
      "assets/audio/*",
      "assets/splash/*"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040C1A",
          "resizeMode": "contain",
          "android": {
            "drawable": {
              "icon": "./plugins/splash-transparent.xml",
              "darkIcon": "./plugins/splash-transparent.xml"
            }
          },
          "dark": {
            "backgroundColor": "#040C1A"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OG Landmark uses your location only when you tap Use My Location to set a property pin.",
          "locationWhenInUsePermission": "OG Landmark uses your location only when you tap Use My Location to set a property pin."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e1d0d001-f2f1-47d6-ac6a-480298d77e2d"
      }
    },
    "owner": "ogland313"
  }
}
