{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/og-landmark-brand-adaptive.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "icon": "./assets/images/og-landmark-brand-square.png",
      "package": "com.oglandmark.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 19
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/videos/*"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e1d0d001-f2f1-47d6-ac6a-480298d77e2d"
      }
    },
    "icon": "./assets/images/og-landmark-brand-square.png",
    "ios": {
      "bundleIdentifier": "com.oglandmark.app",
      "supportsTablet": false
    },
    "name": "OG Landmark",
    "orientation": "portrait",
    "owner": "oglandmark26",
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/og-landmark-splash-safe.png"
          },
          "image": "./assets/images/og-landmark-splash-safe.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OG Landmark uses your location to show nearby properties.",
          "locationWhenInUsePermission": "OG Landmark uses your location to show nearby properties."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "scheme": "og-land-mobile",
    "slug": "og-landmark-uin4dnqfp8-zl28mrpom",
    "userInterfaceStyle": "automatic",
    "version": "2.0.19",
    "web": {
      "favicon": "./assets/images/app-icon-professional.png"
    }
  }
}
