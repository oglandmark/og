{
  "expo": {
    "name": "OG Landmark",
    "slug": "og-land-mobile",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-professional.png",
    "scheme": "og-land-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oglandmark.app"
    },
    "android": {
      "package": "com.oglandmarknew",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/app-icon-professional.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/app-icon-professional.png"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/videos/*"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OG Landmark uses your location to show nearby properties.",
          "locationWhenInUsePermission": "OG Landmark uses your location to show nearby properties."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7870c45d-d618-4d3e-a411-8043469b72eb"
      }
    },
    "owner": "ogmark26"
  }
}
