NODE_ENV=production
# PORT is assigned by Hostinger/Replit. Do not set a fixed PORT value.
# Hostinger MySQL connection string. Keep it private and never commit it.
DATABASE_URL=mysql://user:password@host:3306/database
SESSION_TTL_HOURS=168
APP_URL=https://oglandmark.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Use the full Hostinger mailbox address and that mailbox's password.
SMTP_USER=
SMTP_PASS=
# For port 465 use true; for port 587 use false.
SMTP_SECURE=true
FROM_EMAIL=
FROM_NAME=OG Landmark
# Persistent file/object storage for uploaded images and videos. Never put
# binary media in MySQL. Keep the default directory on Hostinger's persistent
# application volume; set MEDIA_PUBLIC_BASE_URL only when the same files are
# mirrored to a CDN/object-storage public endpoint.
MEDIA_STORAGE_DIR=public/images/uploads
MEDIA_PUBLIC_BASE_URL=