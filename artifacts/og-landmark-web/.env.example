NODE_ENV=production
# PORT is assigned by Hostinger/Replit. Do not set a fixed PORT value.
# Hostinger MySQL connection string. Keep it private and never commit it.
DATABASE_URL=mysql://user:password@host:3306/database
SESSION_TTL_HOURS=168
APP_URL=https://oglandmark.com
# Optional staged cutover: set this to the Laravel API origin (without /api).
# Leave empty to keep all /api traffic on the legacy Node handlers. Removing
# the value is the rollback switch.
LARAVEL_API_URL=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Use the full Hostinger mailbox address and that mailbox's password.
SMTP_USER=
SMTP_PASS=
# For port 465 use true; for port 587 use false.
SMTP_SECURE=true
FROM_EMAIL=
FROM_NAME=OG Landmark
# Persistent file/object storage for uploaded images and videos. Never put
# binary media in MySQL. On Hostinger use the same persistent volume (or
# synchronized object-storage directory) configured for the Laravel API.
MEDIA_STORAGE_DIR=/home/USER/domains/DOMAIN/public_html/shared/media
# Set MEDIA_PUBLIC_BASE_URL only when the same files are mirrored to a CDN or
# object-storage public endpoint.
MEDIA_PUBLIC_BASE_URL=