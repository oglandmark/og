NODE_ENV=production
# PORT is assigned by Hostinger/Replit. Do not set a fixed PORT value.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=og_landmark
MYSQL_USER=og_landmark_user
MYSQL_PASSWORD=change-me
MYSQL_SSL=false
SESSION_TTL_HOURS=168
APP_URL=https://oglandmark.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Use the full Hostinger mailbox address and that mailbox's password.
SMTP_USER=
SMTP_PASS=
# For port 465 use true; for port 587 use false.
SMTP_SECURE=true
FROM_EMAIL=
FROM_NAME=OG Landmark