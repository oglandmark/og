<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve the standalone legal pages when this folder is used as the web root.
  RewriteRule ^privacy-policy/?$ pages/privacy-policy.html [L,NC]
  RewriteRule ^privacy/?$ pages/privacy-policy.html [L,NC]
  RewriteRule ^account-deletion/?$ pages/account-deletion.html [L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>